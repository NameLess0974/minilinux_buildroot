# Binaires compilés
go/build/
*.exe
*.dll
*.so
*.dylib

# Secrets : clés privées, jamais versionnées. Le .crt public peut l'être.
private/certs/server.key
private/keys/bootkey-private.pem
*.key

# Secrets d'environnement (mot de passe admin en clair). Seul .example est versionné.
minilinux.env

# Base de données SQLite (générée automatiquement)
db/*.db
db/*.db-shm
db/*.db-wal
*.db-journal

# Images volumineuses (non versionnées)
data/boot/boot.img
*.img
*.img.xz

# Fichiers Go
*.test
*.out
go/vendor/

# Fichiers temporaires
*.tmp
*.log
*.swp
*.swo
*~
.DS_Store

# IDE / Éditeurs
.vscode/
.idea/
*.iml

# Backup files
*.bak
*.backup
