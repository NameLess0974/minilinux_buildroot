[Unit]
Description=HTTP Boot Server with SD Fallback Detection (Go)
After=network.target
Conflicts=minilinux-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/sabuser/minilinux_buildroot
ExecStart=/usr/local/bin/minilinux-server-go
Restart=always
RestartSec=5

# Environment variables (optional overrides)
Environment=SERVER_PORT=18743
Environment=SERVE_DIRECTORY=/home/sabuser/minilinux_buildroot
Environment=DATABASE_PATH=/home/sabuser/minilinux_buildroot/devices.db
Environment=WHITELIST_FILE=/home/sabuser/minilinux_buildroot/mac_whitelist.txt

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minilinux-server

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sabuser/minilinux_buildroot

[Install]
WantedBy=multi-user.target
