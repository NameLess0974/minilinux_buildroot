[Unit]
Description=HTTPS Boot Server with SD Fallback Detection (Go)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/sabuser/minilinux_buildroot
ExecStart=/usr/local/bin/minilinux-server-go
Restart=always
RestartSec=5

# PROJECT_ROOT ancre tous les chemins par defaut :
#   data/ (servi), db/devices.db, config/mac_whitelist.txt, private/certs/server.{crt,key}
Environment=PROJECT_ROOT=/home/sabuser/minilinux_buildroot
Environment=HTTPS_PORT=18443

# Secrets (SERVICE_TOKEN) charges depuis un fichier non versionne (600).
# Voir deploy/minilinux.env.example. Le "-" rend le fichier optionnel au demarrage.
EnvironmentFile=-/etc/minilinux.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minilinux-server

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sabuser/minilinux_buildroot

[Install]
WantedBy=multi-user.target
