# Secrets du serveur minilinux, charges par systemd (EnvironmentFile).
#
# Installation :
#   sudo cp minilinux.env.example /etc/minilinux.env
#   sudo nano /etc/minilinux.env        # mettre les vraies valeurs
#   sudo chmod 600 /etc/minilinux.env
#   sudo chown root:root /etc/minilinux.env
#
# Ne jamais versionner /etc/minilinux.env.

# Token partage avec le backend middleware, seul client admin de ce serveur.
# Generer :  openssl rand -hex 32
# La MEME valeur doit etre mise cote backend dans BOOTLOADER_SERVICE_TOKEN.
SERVICE_TOKEN=changeme

# Adresse d'ecoute de l'API admin (fleet, images, sessions, logs, actions).
# INTERNE uniquement : le backend middleware tourne sur la meme machine.
ADMIN_ADDR=127.0.0.1:18543

# Proxies dont on accepte X-Forwarded-For / X-Real-IP (separes par des virgules).
# Vide = aucun, on utilise toujours l'IP reelle du pair.
TRUSTED_PROXIES=

# PostgreSQL : base partagee avec le middleware. Memes valeurs que son .env.
# Le serveur y ecrit ses tables boot_* et LIT la table box, qui fait office de
# liste blanche (une box declaree dans la console est autorisee a booter).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=sab
