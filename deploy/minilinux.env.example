# Secrets du serveur minilinux, charges par systemd (EnvironmentFile).
#
# Installation :
#   sudo cp minilinux.env.example /etc/minilinux.env
#   sudo nano /etc/minilinux.env        # mettre les vraies valeurs
#   sudo chmod 600 /etc/minilinux.env
#   sudo chown root:root /etc/minilinux.env
#
# Ne jamais versionner /etc/minilinux.env (il contient le mot de passe en clair).

# Auth admin (HTTP Basic) pour le dashboard et les actions manuelles.
ADMIN_USER=sabsystem
ADMIN_PASS=changeme
