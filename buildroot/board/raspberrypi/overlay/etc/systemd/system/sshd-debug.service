[Unit]
Description=SSH Debug Fallback
After=sshd.service
Wants=sshd.service

[Service]
Type=oneshot
ExecStartPre=/bin/sleep 30
ExecStart=/bin/bash -c 'if ! systemctl is-active --quiet sshd.service; then /usr/local/bin/sshd-debug.sh; fi'
StandardOutput=journal+console
StandardError=journal+console
RemainAfterExit=yes

# [Install] retire volontairement : le sshd natif fonctionne (fix des permissions
# dans post-build.sh), ce contournement n'est plus auto-active. Le fichier reste
# disponible pour un 'systemctl enable sshd-debug' manuel en cas de besoin.
